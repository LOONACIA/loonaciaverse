<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Loonaciaverse.Core/Loonaciaverse.Core.csproj" />
    <ProjectReference Include="../../tools/Loonaciaverse.ContentBuilder/Loonaciaverse.ContentBuilder.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="_ContentBuilderAssembly"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
    <_ContentSource Include="../../content/**/*" />
    <Watch Include="../../content/**/*" />
    <_SceneSource Include="../../scene/src/**/*;../../scene/package.json;../../scene/package-lock.json;../../scene/vite.config.ts;../../scene/tsconfig.json" />
    <Watch Include="../../scene/src/**/*" />
  </ItemGroup>

  <Target Name="PrepareContentBuild" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_ContentBuildStamp>$(IntermediateOutputPath)content-builder.stamp</_ContentBuildStamp>
      <_ContentBuildInputs>$(BaseIntermediateOutputPath)content-builder.inputs</_ContentBuildInputs>
      <_ContentDraftArgument Condition="'$(Configuration)' == 'Debug'">--include-drafts</_ContentDraftArgument>
    </PropertyGroup>
    <!-- The shared input list also invalidates the stamp on deletions and configuration changes. -->
    <WriteLinesToFile File="$(_ContentBuildInputs)" Lines="$(Configuration);@(_ContentSource->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <_ExistingGeneratedContent Include="wwwroot\content\**\*;wwwroot\feed.xml;wwwroot\sitemap.xml;wwwroot\robots.txt" />
      <_RequiredContentOutput Include="wwwroot/content/universe.json;wwwroot/content/posts.json;wwwroot/content/projects.json;wwwroot/content/about.json;wwwroot/feed.xml;wwwroot/sitemap.xml;wwwroot/robots.txt" />
      <_MissingContentOutput Include="@(_RequiredContentOutput)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Delete Files="$(_ContentBuildStamp)" Condition="'@(_MissingContentOutput)' != ''" />
  </Target>

  <Target Name="BuildSiteContent" DependsOnTargets="PrepareContentBuild"
          Inputs="@(_ContentSource);@(_ContentBuilderAssembly);$(_ContentBuildInputs);$(MSBuildProjectFullPath)"
          Outputs="$(_ContentBuildStamp)">
    <Exec Command="dotnet &quot;@(_ContentBuilderAssembly)&quot; --content &quot;$(MSBuildProjectDirectory)/../../content&quot; --output &quot;$(MSBuildProjectDirectory)/wwwroot&quot; $(_ContentDraftArgument)" />
    <Touch Files="$(_ContentBuildStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeGeneratedSiteContent" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BuildSiteContent"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- Re-evaluate after generation so first builds include new assets and omit removed ones. -->
    <ItemGroup>
      <Content Remove="@(_ExistingGeneratedContent)" />
      <Content Include="wwwroot\content\**\*;wwwroot\feed.xml;wwwroot\sitemap.xml;wwwroot\robots.txt" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="$(_ContentBuildStamp);$(_ContentBuildInputs)" />
    </ItemGroup>
  </Target>

  <Target Name="PrepareSceneBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SceneBuildStamp>$(IntermediateOutputPath)scene-bundle.stamp</_SceneBuildStamp>
      <_SceneBuildInputs>$(BaseIntermediateOutputPath)scene-bundle.inputs</_SceneBuildInputs>
      <_SceneDirectory>$(MSBuildProjectDirectory)/../../scene</_SceneDirectory>
    </PropertyGroup>
    <WriteLinesToFile File="$(_SceneBuildInputs)" Lines="@(_SceneSource->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <_ExistingSceneContent Include="wwwroot\js\**\*" />
    </ItemGroup>
    <Delete Files="$(_SceneBuildStamp)" Condition="!Exists('wwwroot/js/highlight.js') Or !Exists('$(_SceneDirectory)/node_modules')" />
    <Exec Command="npm ci" WorkingDirectory="$(_SceneDirectory)" Condition="!Exists('$(_SceneDirectory)/node_modules')" />
  </Target>

  <Target Name="BuildSceneBundle" DependsOnTargets="PrepareSceneBuild" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(_SceneSource);$(_SceneBuildInputs);$(MSBuildProjectFullPath)" Outputs="$(_SceneBuildStamp)">
    <Exec Command="npm run build" WorkingDirectory="$(_SceneDirectory)" />
    <Touch Files="$(_SceneBuildStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeGeneratedSceneContent" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BuildSceneBundle"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <Content Remove="@(_ExistingSceneContent)" />
      <Content Include="wwwroot\js\**\*" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="$(_SceneBuildStamp);$(_SceneBuildInputs)" />
    </ItemGroup>
  </Target>

</Project>
