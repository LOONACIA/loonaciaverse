<section class="hud-panel hud-frame" aria-label="@($"{Body.Name} — {Body.Subtitle}")">
    <button class="hud-close" type="button" aria-label="CLOSE" @onclick="OnClose">✕</button>
    <BodyInfo Body="Body" Stats="Stats" @ref="bodyInfo" />
    <button class="hud-travel" type="button" disabled="@(Body.Locked || Body.Route is null)" @onclick="OnTravel">TRAVEL</button>
</section>

@code {
    [Parameter, EditorRequired]
    public CelestialBody Body { get; set; } = default!;

    [Parameter, EditorRequired]
    public HudStats Stats { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnTravel { get; set; }

    private BodyInfo bodyInfo = default!;

    public ValueTask FocusHeadingAsync() => bodyInfo.FocusHeadingAsync();
}
