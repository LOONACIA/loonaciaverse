@page "/blog/{Slug}"
@layout PageLayout
@inject IContentService ContentService

<ContentLoader @key="Slug" TItem="PostDetail" Load="cancellationToken => ContentService.GetPostAsync(Slug, cancellationToken)" Context="post">
    <PageMeta Title="@post.Meta.Title" Description="@post.Meta.Summary" />
    <div class="post-layout @(post.Toc.Count > 0 ? "has-toc" : null)">
        <article class="blog-post">
            <PageHeader BodyId="blog" Title="@post.Meta.Title">
                <p class="post-meta">
                    PUBLISHED <time datetime="@Formatting.FormatDate(post.Meta.Date)">@Formatting.FormatDate(post.Meta.Date)</time>
                    @if (post.Meta.Updated is { } updated)
                    {
                        <span> · UPDATED <time datetime="@Formatting.FormatDate(updated)">@Formatting.FormatDate(updated)</time></span>
                    }
                </p>
                @if (post.Meta.Draft)
                {
                    <span class="badge badge-draft">DRAFT</span>
                }
                <ul class="post-tags" aria-label="태그">
                    @foreach (var tag in post.Meta.Tags)
                    {
                        <li><a class="chip" href="/blog/tags/@Uri.EscapeDataString(tag)">@tag</a></li>
                    }
                </ul>
            </PageHeader>
            @if (post.Series is { } series)
            {
                <SeriesBox Series="series" CurrentSlug="@post.Meta.Slug" />
            }
            @if (post.Meta.Cover is { } cover)
            {
                <img class="post-cover" src="@cover" alt="" />
            }
            <ContentBody Html="@post.Html" />
            @if (post.Series is { } navigationSeries)
            {
                <SeriesNav Series="navigationSeries" CurrentSlug="@post.Meta.Slug" />
            }
            <a class="all-posts" href="/blog">← ALL POSTS</a>
        </article>
        <TableOfContents Entries="post.Toc" />
    </div>
</ContentLoader>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;
}
